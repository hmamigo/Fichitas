diff --git a/scripts/unlock_codes.gd b/scripts/unlock_codes.gd
new file mode 100644
index 0000000..b212efa
--- /dev/null
+++ b/scripts/unlock_codes.gd
@@ -0,0 +1,107 @@
+class_name UnlockCodes
+extends RefCounted
+## Códigos de desbloqueo para materias de pago, sin servidor. Un código es
+##   F1.<carga>.<firma>
+## donde la carga es un JSON {"v":1,"p":[ids de materia o "*"],"n":"nombre"} y la firma es
+## RSA-SHA256 de esa carga. El juego solo trae la clave pública (UnlockKey): puede comprobar
+## códigos, pero no fabricarlos. Un código se puede compartir y no se puede revocar: es un
+## candado de cortesía, no una protección (las imágenes viajan dentro de la app).
+
+const PREFIX := "F1"
+const MAX_IDS := 20
+const MAX_NAME := 40
+const ID_CHARS := "abcdefghijklmnopqrstuvwxyz0123456789_-"
+const CODE_CHARS := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-."
+
+static var public_pem: String = ""   # vacío = usa UnlockKey.PEM (las pruebas lo sustituyen)
+
+## Crea un código firmado. Solo sirve con la clave privada (herramienta del desarrollador y pruebas).
+static func make_code(private_key: CryptoKey, ids: Array, buyer: String = "") -> String:
+	var payload: PackedByteArray = JSON.stringify({"v": 1, "p": ids, "n": buyer}).to_utf8_buffer()
+	var sig: PackedByteArray = Crypto.new().sign(HashingContext.HASH_SHA256, _sha256(payload), private_key)
+	return "%s.%s.%s" % [PREFIX, _b64(payload), _b64(sig)]
+
+## Comprueba un código sin tocar el progreso. {ok: true, ids, name} o {ok: false, error}.
+static func verify(code: String) -> Dictionary:
+	var pem: String = public_pem if public_pem != "" else UnlockKey.PEM
+	if pem.strip_edges() == "":
+		return _fail("Este juego aún no tiene los códigos configurados.")
+	var key := CryptoKey.new()
+	if key.load_from_string(pem, true) != OK:
+		return _fail("La clave del juego para los códigos no es válida.")
+	var parts: PackedStringArray = _clean(code).split(".")
+	if parts.size() != 3 or parts[0] != PREFIX:
+		return _fail("El código no tiene el formato esperado. Pégalo completo.")
+	var payload: PackedByteArray = _unb64(parts[1])
+	var sig: PackedByteArray = _unb64(parts[2])
+	if payload.is_empty() or sig.is_empty():
+		return _fail("El código está incompleto. Pégalo completo.")
+	if not Crypto.new().verify(HashingContext.HASH_SHA256, _sha256(payload), sig, key):
+		return _fail("El código no es válido.")
+	var json := JSON.new()
+	if json.parse(payload.get_string_from_utf8()) != OK or not (json.data is Dictionary):
+		return _fail("El código no es válido.")
+	var data: Dictionary = json.data
+	var raw = data.get("p", null)
+	if int(data.get("v", 0)) != 1 or not (raw is Array):
+		return _fail("Este código es de otra versión del juego.")
+	var ids: Array = []
+	for id in (raw as Array):
+		var s: String = str(id)
+		if s != "*" and not _valid_id(s):
+			return _fail("El código no es válido.")
+		if not ids.has(s):
+			ids.append(s)
+	if ids.is_empty() or ids.size() > MAX_IDS:
+		return _fail("El código no es válido.")
+	return {"ok": true, "ids": ids, "name": str(data.get("n", "")).substr(0, MAX_NAME)}
+
+## Comprueba el código y, si vale, desbloquea las materias (queda guardado en el progreso).
+static func redeem(code: String) -> Dictionary:
+	var r: Dictionary = verify(code)
+	if not bool(r["ok"]):
+		return r
+	var owned: Array = Progress.data["owned"]
+	for id in r["ids"]:
+		if not owned.has(id):
+			owned.append(id)
+	Progress.data["owned"] = owned
+	Progress.save()
+	return r
+
+# ---------- Interno ----------
+
+static func _fail(msg: String) -> Dictionary:
+	return {"ok": false, "error": msg}
+
+static func _valid_id(id: String) -> bool:
+	if id.is_empty() or id.length() > 32:
+		return false
+	for c in id:
+		if not ID_CHARS.contains(c):
+			return false
+	return true
+
+## Conserva solo los caracteres de un código: tolera espacios, saltos de línea y comillas
+## que se cuelan al copiar desde un chat o un correo.
+static func _clean(code: String) -> String:
+	var out: String = ""
+	for c in code:
+		if CODE_CHARS.contains(c):
+			out += c
+	return out
+
+static func _sha256(bytes: PackedByteArray) -> PackedByteArray:
+	var ctx := HashingContext.new()
+	ctx.start(HashingContext.HASH_SHA256)
+	ctx.update(bytes)
+	return ctx.finish()
+
+static func _b64(bytes: PackedByteArray) -> String:
+	return Marshalls.raw_to_base64(bytes).replace("+", "-").replace("/", "_").replace("=", "")
+
+static func _unb64(s: String) -> PackedByteArray:
+	var t: String = s.replace("-", "+").replace("_", "/")
+	while t.length() % 4 != 0:
+		t += "="
+	return Marshalls.base64_to_raw(t)
