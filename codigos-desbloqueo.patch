new file mode 100644
index 0000000..7b5e296
--- /dev/null
+++ b/tools/codigos.gd
@@ -0,0 +1,95 @@
+extends SceneTree
+## Herramienta del desarrollador (no forma parte del juego): crea las claves y emite códigos
+## de desbloqueo. Se ejecuta desde la carpeta del proyecto:
+##
+##   godot --headless --path . --script res://tools/codigos.gd -- keygen
+##   godot --headless --path . --script res://tools/codigos.gd -- emitir historia,fis "Ana"
+##   godot --headless --path . --script res://tools/codigos.gd -- emitir "*"
+##
+## keygen:  crea la clave privada en tools/privado/ (ignorada por git: NO la subas ni la pierdas) y
+##          escribe la pública en scripts/unlock_key.gd, que sí se sube. Hazlo UNA sola vez: otra
+##          clave invalida todos los códigos ya entregados (pide --force para permitirlo).
+## emitir:  imprime un código para las materias indicadas ("*" = todas las de pago) y lo anota en
+##          tools/privado/codigos_emitidos.txt. El nombre es opcional y solo sirve para ti.
+
+const PRIV_DIR := "res://tools/privado"
+const PRIV_KEY := "res://tools/privado/clave_privada.pem"
+const LOG := "res://tools/privado/codigos_emitidos.txt"
+const PUB_SCRIPT := "res://scripts/unlock_key.gd"
+
+func _init() -> void:
+	var args: PackedStringArray = OS.get_cmdline_user_args()
+	if args.is_empty():
+		_usage()
+		quit(1)
+		return
+	match args[0]:
+		"keygen":
+			quit(_keygen(args.has("--force")))
+		"emitir":
+			if args.size() < 2:
+				_usage()
+				quit(1)
+			else:
+				quit(_emit(args[1], args[2] if args.size() > 2 else ""))
+		_:
+			_usage()
+			quit(1)
+
+func _usage() -> void:
+	print("Uso:")
+	print("  -- keygen")
+	print("  -- emitir <ids separados por coma | *> [nombre]")
+
+func _keygen(force: bool) -> int:
+	if UnlockKey.PEM.strip_edges() != "" and not force:
+		print("Ya hay una clave pública en scripts/unlock_key.gd. Otra clave invalidaría los códigos ya entregados.")
+		print("Si de verdad lo quieres, repite con --force.")
+		return 1
+	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(PRIV_DIR))
+	var key: CryptoKey = Crypto.new().generate_rsa(2048)
+	if key.save(PRIV_KEY, false) != OK:
+		print("No se pudo guardar la clave privada.")
+		return 1
+	var ign := FileAccess.open(PRIV_DIR + "/.gdignore", FileAccess.WRITE)  # que el editor no escanee la carpeta
+	if ign != null:
+		ign.close()
+	var pub: String = key.save_to_string(true).strip_edges()
+	var f := FileAccess.open(PUB_SCRIPT, FileAccess.WRITE)
+	if f == null:
+		print("No se pudo escribir scripts/unlock_key.gd.")
+		return 1
+	f.store_string("class_name UnlockKey\nextends RefCounted\n## Clave PÚBLICA con la que el juego comprueba los códigos de desbloqueo (sin servidor).\n## La genera `tools/codigos.gd keygen`; la privada se queda en tu computador y no se sube.\n## Mientras esta constante esté vacía, el juego no acepta ningún código.\n\nconst PEM := \"\"\"\n%s\n\"\"\"\n" % pub)
+	f.close()
+	print("Listo. Clave privada: tools/privado/clave_privada.pem (guárdala en un lugar seguro y haz copia).")
+	print("Clave pública: scripts/unlock_key.gd (esa sí va en el repositorio).")
+	return 0
+
+func _emit(ids_arg: String, buyer: String) -> int:
+	var key := CryptoKey.new()
+	if key.load(PRIV_KEY, false) != OK:
+		print("No hay clave privada. Ejecuta primero: -- keygen")
+		return 1
+	var ids: Array = []
+	for s in ids_arg.split(","):
+		var id: String = s.strip_edges().to_lower()
+		if id != "" and not ids.has(id):
+			ids.append(id)
+	if ids.is_empty():
+		print("Indica al menos una materia (o *).")
+		return 1
+	var code: String = UnlockCodes.make_code(key, ids, buyer)
+	var check: Dictionary = UnlockCodes.verify(code)
+	if not bool(check["ok"]):
+		print("El código no pasó la comprobación con scripts/unlock_key.gd: ¿cambiaste de clave? (%s)" % check["error"])
+		return 1
+	var log := FileAccess.open(LOG, FileAccess.READ_WRITE if FileAccess.file_exists(LOG) else FileAccess.WRITE)
+	if log != null:
+		log.seek_end()
+		log.store_line("%s | %s | %s" % [Time.get_datetime_string_from_system(), ",".join(ids), buyer])
+		log.close()
+	print("")
+	print("Materias: %s%s" % [",".join(ids), (" · para " + buyer) if buyer != "" else ""])
+	print("Código (cópialo completo):")
+	print(code)
+	return 0
