@@ -0,0 +1,7 @@
+class_name UnlockKey
+extends RefCounted
+## Clave PÚBLICA con la que el juego comprueba los códigos de desbloqueo (sin servidor).
+## La genera `tools/codigos.gd keygen`; la privada se queda en tu computador y no se sube.
+## Mientras esta constante esté vacía, el juego no acepta ningún código.
+
+const PEM := ""
diff --git a/tests/test_codes.gd b/tests/test_codes.gd
new file mode 100644
index 0000000..4b3ff4d
--- /dev/null
+++ b/tests/test_codes.gd
@@ -0,0 +1,96 @@
+extends SceneTree
+## Códigos de desbloqueo: godot --headless --path . --script res://tests/test_codes.gd
+
+var fails: int = 0
+
+func check(ok: bool, msg: String) -> void:
+	print(("  OK   " if ok else "  FALLA ") + msg)
+	if not ok:
+		fails += 1
+
+func _init() -> void:
+	_run()
+
+func _run() -> void:
+	Progress.path = "user://test_codes_progress.json"
+	PackImport.dir = "user://test_packs_empty"
+	if FileAccess.file_exists(Progress.path):
+		DirAccess.remove_absolute(ProjectSettings.globalize_path(Progress.path))
+	Progress.load_data()
+	var crypto := Crypto.new()
+	var key: CryptoKey = crypto.generate_rsa(2048)
+	var other: CryptoKey = crypto.generate_rsa(2048)
+
+	print("Sin clave configurada")
+	UnlockCodes.public_pem = ""
+	var r: Dictionary = UnlockCodes.verify(UnlockCodes.make_code(key, ["fis"], "Ana"))
+	check(not bool(r["ok"]) and UnlockKey.PEM == "", "con UnlockKey vacía no se acepta ningún código")
+
+	print("Códigos válidos")
+	UnlockCodes.public_pem = key.save_to_string(true)
+	var code: String = UnlockCodes.make_code(key, ["fis", "historia"], "Ana")
+	r = UnlockCodes.verify(code)
+	check(bool(r["ok"]) and r["ids"] == ["fis", "historia"] and r["name"] == "Ana", "un código firmado se acepta y trae sus materias")
+	check(code.begins_with("F1.") and code.split(".").size() == 3, "formato F1.<carga>.<firma>")
+	var messy: String = "  \"%s\"\n" % code.insert(40, "\n").insert(90, " ").insert(150, "\r\n")
+	check(bool(UnlockCodes.verify(messy)["ok"]), "tolera espacios, saltos de línea y comillas al pegar")
+	check((Progress.data["owned"] as Array).is_empty(), "verify no toca el progreso")
+
+	print("Canjear")
+	r = UnlockCodes.redeem(code)
+	var owned: Array = Progress.data["owned"]
+	check(bool(r["ok"]) and owned.has("fis") and owned.has("historia"), "canjear guarda las materias en owned")
+	UnlockCodes.redeem(code)
+	check((Progress.data["owned"] as Array).size() == 2, "canjear dos veces no duplica")
+	Progress.load_data()
+	check((Progress.data["owned"] as Array).has("fis"), "lo desbloqueado se conserva al reabrir el juego")
+	Progress.reset()
+	check((Progress.data["owned"] as Array).has("fis"), "reiniciar el progreso no quita lo desbloqueado")
+	var pro := {"id": "fis", "premium": true}
+	var closed := {"id": "qui", "premium": true}
+	check(Levels.is_open(pro) and not Levels.is_open(closed), "Levels.is_open respeta owned")
+	UnlockCodes.redeem(UnlockCodes.make_code(key, ["*"]))
+	check(Levels.is_open(closed), "\"*\" abre todas las materias de pago")
+
+	print("Rechazos")
+	check(not bool(UnlockCodes.verify(UnlockCodes.make_code(other, ["qui"]))["ok"]), "firmado con otra clave: rechazado")
+	var parts: PackedStringArray = code.split(".")
+	var forged: PackedByteArray = Marshalls.base64_to_raw(parts[1].replace("-", "+").replace("_", "/") + "==")
+	var tampered: String = parts[0] + "." + Marshalls.raw_to_base64(forged.get_string_from_utf8().replace("fis", "qui").to_utf8_buffer()).replace("+", "-").replace("/", "_").replace("=", "") + "." + parts[2]
+	check(not bool(UnlockCodes.verify(tampered)["ok"]), "carga modificada con la firma original: rechazado")
+	var bad_sig: String = parts[0] + "." + parts[1] + "." + parts[2].substr(0, parts[2].length() - 4) + "AAAA"
+	check(not bool(UnlockCodes.verify(bad_sig)["ok"]), "firma alterada: rechazado")
+	check(not bool(UnlockCodes.verify(parts[0] + "." + parts[1])["ok"]), "código incompleto: rechazado")
+	check(not bool(UnlockCodes.verify("hola")["ok"]) and not bool(UnlockCodes.verify("")["ok"]), "texto cualquiera o vacío: rechazado")
+	check(not bool(UnlockCodes.verify(UnlockCodes.make_code(key, ["../x"]))["ok"]), "ids con caracteres raros: rechazado")
+	check(not bool(UnlockCodes.verify(UnlockCodes.make_code(key, []))["ok"]), "sin materias: rechazado")
+	var many: Array = []
+	for i in 25:
+		many.append("m%d" % i)
+	check(not bool(UnlockCodes.verify(UnlockCodes.make_code(key, many))["ok"]), "demasiadas materias: rechazado")
+
+	print("Flujo en el juego")
+	Progress.data["owned"] = []
+	Progress.save()
+	var main: Node = (load("res://scenes/main.tscn") as PackedScene).instantiate()
+	root.add_child(main)
+	for i in 3:
+		await process_frame
+	main._go_subjects()
+	var base_tiles: int = main.board.subject_station.tiles.size()
+	(main._pack("fis") as Dictionary)["premium"] = true
+	main._go_subjects()
+	check(not Levels.is_open(main._pack("fis")), "una materia de pago queda bloqueada")
+	check(main.board.subject_station.tiles.size() == base_tiles + 1, "con materias de pago aparece la tarjeta \"Tengo un código\"")
+	main._on_subject(":code")
+	check(main.ui.code_overlay.visible, "la tarjeta abre la ventana del código")
+	main._on_code(UnlockCodes.make_code(other, ["fis"]))
+	check(main.ui.code_overlay.visible and main.ui._code_msg.text != "" and not Levels.is_open(main._pack("fis")), "un código malo muestra el motivo y no abre nada")
+	main._on_back()
+	check(main.state == 1 and not main.ui.code_overlay.visible, "Atrás cierra primero la ventana del código")
+	main._on_subject(":code")
+	main._on_code(UnlockCodes.make_code(key, ["fis"], "Ana"))
+	check(Levels.is_open(main._pack("fis")) and not main.ui.code_overlay.visible and main.state == 1, "un código bueno abre la materia y cierra la ventana")
+
+	print("Resultado: %s" % ("TODO OK" if fails == 0 else "%d fallos" % fails))
+	quit(0 if fails == 0 else 1)
